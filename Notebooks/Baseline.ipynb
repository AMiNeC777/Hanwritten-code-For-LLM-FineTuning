    "import pandas as pd\n",
    "import \n",
    "\n",
    "word_vectorizer = TfidfVectorizer(analyzer=\"word\", ngram_range=(1, 2))\n",
    "char_vectorizer = TfidfVectorizer(analyzer=\"char\", ngram_range=(2, 5))\n",
    "tfidf = FeatureUnion([(\"word\", word_vectorizer), (\"char\", char_vectorizer)])"
   ]
